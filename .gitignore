# Local machine config — never portable, contains an absolute SDK path.
/local.properties

# Build outputs
**/build/
.gradle/
.kotlin/

# Native build intermediates (NDK/CMake)
**/.cxx/
**/.externalNativeBuild/

# The vendored nodejs-mobile runtime (~190MB of .so binaries + headers) — real build
# input, kept ON DISK, but never committed. See PROVENANCE.md for what's known about it.
composeApp/src/androidMain/cpp/libnode/

# IDE
.idea/
*.iml
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Agent tooling scratch — not project source
.omc/

# Generated by scripts/stage-daemon-assets.mjs from the turbollm build output.
# Not committed: it is ~14.5 MB of build artefacts that would churn on every daemon change.
# Run that script before assembling an APK, or the app ships without its daemon.
composeApp/src/androidMain/assets/daemon/

# Play Store upload signing — the keystore and its credentials must never be committed.
# Losing OR leaking these after the app is live means Google support is the only recovery.
/keystore/
*.jks
*.keystore

# Google Play publishing service-account credential (Gradle Play Publisher). Whatever this is
# named and wherever it lives, it must never be committed — see composeApp/build.gradle.kts's
# playServiceAccountFile comment for why (Scout, the reference project, commits its own copy —
# do not repeat that here).
*play-account*.json
*play-publish*.json
