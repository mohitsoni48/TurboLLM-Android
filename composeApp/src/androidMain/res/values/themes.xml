<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Compose — no XML layouts) -->
    <style name="Base.Theme.TurboLLM" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/turbollm_primary</item>
        <item name="colorPrimaryVariant">@color/turbollm_primary_dark</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/turbollm_status_bar</item>
        <!-- Branded orange status bar (see colors.xml) is dark enough to need light
             icons/clock/battery, same as white text on the web UI's accent-button token —
             true in both themes, unlike a light-mode-tuned background would need. -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- QA_BUGS.md BUG-08: was the platform default (off-white/pink), visible as a jarring
             flash before Compose's first frame on a cold start — see colors.xml. -->
        <item name="android:windowBackground">@color/turbollm_window_bg</item>
    </style>

    <style name="Theme.TurboLLM" parent="Base.Theme.TurboLLM" />

    <!-- A real splash-screen variant (BLUEPRINT.md §6's loading state, distinct from this
         theme, with the Android 12+ SplashScreen API) is Phase 2 scope, not Spike A —
         AndroidManifest.xml intentionally points at the plain theme above until then. -->
</resources>
