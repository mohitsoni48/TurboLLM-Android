<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="turbollm_primary">#FF6C3CE1</color>
    <color name="turbollm_primary_dark">#FF4A1FB5</color>
    <!-- Founder call: the status bar should read as TurboLLM-branded orange in both themes,
         not blend into the app background — same color as the launcher icon/accent, sampled
         from turbollm/src/webdist/brand/turbollm-icon-512.jpeg (matches ic_launcher_background
         and the web UI's accent token, index.css spec 11 §1). Not overridden in
         values-night/colors.xml — this one doesn't flip per theme. -->
    <color name="turbollm_status_bar">#FFCA6644</color>
    <!-- Matches TurboLLMTheme's Compose `background` (App.kt) — QA_BUGS.md BUG-08: the raw
         Android window paints this color for the brief window between process start and
         Compose's first frame (most visible on a force-stop cold start), so it must match the
         "Starting TurboLLM…" screen behind it instead of the platform's default window
         background, which read as a jarring off-white/pink flash. -->
    <color name="turbollm_window_bg">#FFF8F9FA</color>
</resources>
