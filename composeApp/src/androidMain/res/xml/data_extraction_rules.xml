<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules): the same exclusions as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="daemon.log" />
        <exclude domain="file" path="daemon.log.1" />
        <exclude domain="file" path="last-crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="daemon.log" />
        <exclude domain="file" path="daemon.log.1" />
        <exclude domain="file" path="last-crash.txt" />
    </device-transfer>
</data-extraction-rules>
